{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transpile block schema",
  "description": "Pinned schema for image/PDF content transpilation. The document is a fixed envelope wrapping an ordered array of typed blocks. Field names are fixed; values are filled by the reader. Column and series names are taken verbatim from the source, never paraphrased.",
  "type": "object",
  "required": ["source", "blocks"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["file", "kind"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "kind": {"enum": ["pdf", "image", "html"]},
        "pages": {"type": "integer"}
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {"enum": ["table", "series", "metric", "entities", "prose", "figure"]},
          "id": {"type": "string", "pattern": "^b[0-9]{4}$"}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "table"}}},
           "then": {"required": ["title", "columns", "rows", "value_method"],
             "properties": {
               "title": {"type": "string"},
               "columns": {"type": "array", "items": {"type": "string"}},
               "rows": {"type": "array", "items": {"type": "array"}},
               "unit": {"type": "string"},
               "value_method": {"enum": ["labelled", "estimated"]}
             }}},
          {"if": {"properties": {"type": {"const": "series"}}},
           "then": {"required": ["title", "series", "value_method"],
             "properties": {
               "title": {"type": "string"},
               "chart_kind": {"type": "string"},
               "x": {"type": "object", "properties": {"label": {"type": "string"}, "unit": {"type": "string"}}},
               "y": {"type": "object", "properties": {"label": {"type": "string"}, "unit": {"type": "string"}}},
               "series": {"type": "array", "items": {
                 "type": "object", "required": ["name", "points"],
                 "properties": {"name": {"type": "string"},
                   "points": {"type": "array", "items": {
                     "type": "object", "required": ["x", "y"],
                     "properties": {"x": {}, "y": {"type": ["number", "null"]}}}}}}},
               "value_method": {"enum": ["labelled", "estimated"]},
               "confidence": {"enum": ["high", "medium", "low"]}
             }}},
          {"if": {"properties": {"type": {"const": "metric"}}},
           "then": {"required": ["name", "value", "value_method"],
             "properties": {
               "name": {"type": "string"},
               "value": {"type": ["number", "string"]},
               "unit": {"type": "string"},
               "period": {"type": "string"},
               "value_method": {"enum": ["labelled", "estimated"]}
             }}},
          {"if": {"properties": {"type": {"const": "entities"}}},
           "then": {"required": ["title", "nodes"],
             "properties": {
               "title": {"type": "string"},
               "nodes": {"type": "array", "items": {
                 "type": "object", "required": ["name"],
                 "properties": {"name": {"type": "string"}, "detail": {"type": "string"}}}},
               "relations": {"type": "array", "items": {
                 "type": "object", "required": ["from", "to"],
                 "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string"}}}}
             }}},
          {"if": {"properties": {"type": {"const": "prose"}}},
           "then": {"required": ["text"],
             "properties": {"heading": {"type": "string"}, "text": {"type": "string"}}}},
          {"if": {"properties": {"type": {"const": "figure"}}},
           "then": {"required": ["caption"],
             "properties": {"caption": {"type": "string"}}}}
        ]
      }
    }
  }
}
