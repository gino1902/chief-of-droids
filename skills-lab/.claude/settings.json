{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Skill(writing-requirements)",

      "Bash(claude plugin *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(md5 *)",

      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:json-schema.org)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:spec.commonmark.org)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:www.typescriptlang.org)"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "if": "Skill(skill-creator*)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-skill-docs.sh"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "skill-creator:skill-creator",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-skill-docs.sh"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
